# Copy to .env (which is gitignored) and fill in only what you use.
# Every key is optional; see README "Installation" and "Choosing a Model".

# --- LLM providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Gemini via Vertex AI instead of GEMINI_API_KEY:
# VERTEX_AI_PROJECT=
# VERTEX_AI_LOCATION=
# OPENROUTER_API_KEY=

# --- Self-hosted / open-source models ---
# OLLAMA_API_BASE=http://localhost:11434
# HOSTED_VLLM_API_BASE=http://localhost:8000/v1
# LM_STUDIO_API_BASE=http://localhost:1234/v1

# --- Literature search (optional; keyless access works but is rate-limited) ---
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
# PAPER_SEARCH_SOURCES=s2,openalex,arxiv

# --- Default models (optional; CLI flags override) ---
# PAPER_WRITER_MODEL=openai/gpt-5
# PAPER_FAST_MODEL=openai/gpt-5-mini
# PAPER_IMAGE_MODEL=none

# --- Streamlit demo email notifications (optional) ---
# SMTP_EMAIL=
# SMTP_PASSWORD=
